# Copy to .env and replace this value, or run scripts/start.ps1 to generate it.
POSTGRES_PASSWORD=replace-with-a-local-password
# Run scripts/start.ps1 to generate a 64-character random hex key.
AGENT_SHARED_KEY=replace-with-64-random-hex-characters
# Server-side choice: langgraph or dotnet. There is no automatic failover.
CHAT_BACKEND=langgraph
DEMO_ALEX_PASSWORD=replace-with-a-unique-12-character-or-longer-password-A1!
DEMO_SAM_PASSWORD=replace-with-another-unique-12-character-or-longer-password-B2!
DEMO_ADMIN_PASSWORD=replace-with-a-separate-unique-admin-password-C3!
