{
  "name": "commercepilot-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "mcp": "tsx src/index.ts",
    "ask": "tsx src/ask.ts",
    "ask:preview": "tsx src/ask.ts --trace-preview",
    "ask:trace": "tsx src/ask.ts --trace",
    "chat": "tsx src/chat.ts",
    "chat:ram": "tsx src/chat.ts ram",
    "chat:postgres": "tsx src/chat.ts postgres",
    "memory:setup": "tsx src/memory-admin.ts setup",
    "memory:prune": "tsx src/memory-admin.ts prune",
    "test:memory": "tsx --test tests/postgres-memory.integration.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@langchain/ollama": "1.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "langsmith": "0.11.0",
    "pg": "8.23.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
