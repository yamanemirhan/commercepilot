# Copy to .local/langsmith.env at the repository root (excluded from Git).
# Create a Tracing Only key scoped to your workspace. Do not paste it into chat.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=commercepilot-learning
# US: https://api.smith.langchain.com | EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required for keys spanning multiple workspaces; otherwise leave blank.
LANGSMITH_WORKSPACE_ID=
# Tracing is opt-in per command: npm.cmd --prefix tools/commerce-agent run ask:trace -- 'Hello!'
